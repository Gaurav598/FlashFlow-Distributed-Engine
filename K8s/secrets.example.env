# Copy to K8s/secrets.env (ignored by Git) and replace every value.
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
GATEWAY_SERVICE_SECRET=replace-with-a-different-32-character-gateway-secret
ORDER_SERVICE_SECRET=replace-with-a-different-32-character-order-secret
REDIS_PASSWORD=replace-with-a-strong-redis-password
ACCESS_TOKEN_EXPIRY=1h
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_USERNAME=flashflow-admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-bootstrap-password
